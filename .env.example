# ==============================================================================
# 🚀 تنظیمات محیطی سامانه یکپارچه کارویتا (KaroVita Cloud Platform)
# ==============================================================================

# --- [تنظیمات عمومی سرور / Server Core Settings] ---
APP_NAME=KaroVita
APP_ENV=production
APP_KEY=secret_key_owj_abri_secure_change_me_123456789
PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=/api

# --- [درگاه پرداخت آنلاین زیبال و شاپرک / Zibal Payment Gateway] ---
# برای حالت تست مقدار 'zibal' و merchant_id را 'zibal' بگذارید
PAYMENT_DRIVER=zibal
ZIBAL_MERCHANT_KEY=zibal
ZIBAL_CALLBACK_URL=/api/payment/zibal/callback
ZIBAL_SANDBOX=true

# --- [درگاه پیامک کد تایید OTP / SMS Provider Options] ---
# گزینه‌ها: 'sms_ir' یا 'mediana'
SMS_DRIVER=sms_ir

# تنظیمات SMS.ir (Fast Send Verify API)
SMS_IR_API_KEY=ocv39CACg6Vg3cg3DbY3mUwfOti7dktYUwksl3jA3Jt1qI0z
SMS_IR_TEMPLATE_ID=418155
SMS_IR_PARAM_NAME=CODE

# تنظیمات مدیانا (Mediana Pattern SMS)
MEDIANA_API_KEY=
MEDIANA_BASE_URL=https://ippanel.com/api/select
MEDIANA_PATTERN_CODE=
MEDIANA_CODE_PARAM=code
MEDIANA_AUTH_HEADER=Authorization
MEDIANA_AUTH_PREFIX=AccessKey

# قوانین امنیتی و زمان‌بندی OTP
OTP_TTL_SECONDS=120
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=10

# --- [اعلان‌های وب و پوش‌نوتیفیکیشن / Web Push (VAPID)] ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@karovita.ir

# --- [پایگاه داده MySQL (در صورت استفاده از Backend لاراول / MySQL)] ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karovita_db
DB_USERNAME=karovita_user
DB_PASSWORD=YourStrongDatabasePassword123!
