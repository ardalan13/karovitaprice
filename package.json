{
  "name": "karovita-cloud-erp",
  "version": "2.0.0",
  "description": "سامانه یکپارچه مدیریت کسب‌وکار کارویتا (ERP ابری)، فاکتورهای رسمی مالیاتی، درگاه زیبال و سیستم تیکتینگ",
  "author": "Ardalan Davodi <ardalan.davodi@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "karovita",
    "erp",
    "cloud-pricing",
    "tax-invoice",
    "zibal",
    "sms-otp",
    "pwa",
    "react",
    "express"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "vite": "^5.4.11"
  }
}
