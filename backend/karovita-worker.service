[Unit]
Description=KaroVita Queue Worker
After=network.target redis.service mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/karovita/backend
ExecStart=/usr/bin/php /var/www/karovita/backend/artisan queue:work redis --sleep=3 --tries=3 --max-time=3600 --timeout=300
Restart=always
RestartSec=5
StandardOutput=append:/var/log/karovita/queue-worker.log
StandardError=append:/var/log/karovita/queue-worker-error.log

# Restart worker gracefully on code updates
ExecReload=/bin/kill -USR2 $MAINPID

[Install]
WantedBy=multi-user.target
