APP_NAME="KaroVita Cloud ERP"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://api.yourdomain.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (Use strong passwords)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=karovita_production
DB_USERNAME=karovita_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Session & Cache (Use Redis in production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=karovita_cache_

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Frontend URL & CORS (CRITICAL: Set to actual production domains)
FRONTEND_URL=https://yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# Admin Mobile Numbers (Comma-separated, no spaces)
ADMIN_MOBILES=09123456789,09987654321

# SMS.ir Configuration (Keep SECRET)
SMS_DRIVER=sms_ir
SMS_IR_API_KEY=YOUR_SMS_IR_API_KEY_HERE
SMS_IR_LINE_NUMBER=30007732
SMS_IR_TEMPLATE_OTP=418155
SMS_IR_PARAM_NAME=CODE
SMS_IR_TEMPLATE_INVOICE=418155
SMS_IR_TEMPLATE_PAYMENT=418155

# Zibal Payment Gateway
ZIBAL_MERCHANT=zibal
ZIBAL_SANDBOX=false
ZIBAL_CALLBACK_URL=https://api.yourdomain.com/api/payments/zibal/callback
