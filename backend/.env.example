APP_NAME="KaroVita Cloud ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://api.your-domain.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=karovita_db
DB_USERNAME=karovita_user
DB_PASSWORD=your_strong_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=karovita_cache_

# Frontend URL & CORS for React SPA
FRONTEND_URL=https://your-domain.com,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=your-domain.com,localhost:3000

# SMS.ir Pattern OTP Gateway
SMS_DRIVER=sms_ir
SMS_IR_API_KEY=ocv39CACg6Vg3cg3DbY3mUwfOti7dktYUwksl3jA3Jt1qI0z
SMS_IR_LINE_NUMBER=30007732
SMS_IR_TEMPLATE_ID=418155
SMS_IR_PARAM_NAME=CODE
SMS_IR_TEMPLATE_INVOICE=418155
SMS_IR_TEMPLATE_PAYMENT=418155

# Zibal Shaparak Payment Gateway
ZIBAL_MERCHANT=zibal
ZIBAL_SANDBOX=true
ZIBAL_CALLBACK_URL=https://api.your-domain.com/api/payments/zibal/callback

